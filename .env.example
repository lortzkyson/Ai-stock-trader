# Copy to .env and fill in. Never commit the real .env (it's git-ignored).

# Alpaca trading API (paper first — see docs/pre-mortem.md and Phase 7/8).
# Also used for historical market data (src/data/alpaca_client.py) — see
# docs/data_feed_decision.md for why no separate data provider is needed.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# https://paper-api.alpaca.markets for paper trading, https://api.alpaca.markets for live
ALPACA_BASE_URL=https://paper-api.alpaca.markets
