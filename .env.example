# Copy to .env and fill in. Never commit the real .env (it's git-ignored).

# Alpaca trading API (paper first — see docs/pre-mortem.md and Phase 7/8)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# https://paper-api.alpaca.markets for paper trading, https://api.alpaca.markets for live
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Market data provider (Phase 2 decides between Alpaca's own feed and an
# alternative like Polygon.io based on IEX-vs-SIP coverage — see docs/pre-mortem.md)
MARKET_DATA_API_KEY=
